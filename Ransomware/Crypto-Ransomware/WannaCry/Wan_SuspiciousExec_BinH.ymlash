title: WannaCry Ransomware Execution (Process Creation)
id: a1b2c3d4-1111-406a-9f5b-1d7e2f5b8a9c
status: stable
description: Detects the execution of WannaCry Ransomware based on specific hashes, dropper filenames (mssecsvc.exe, tasksche.exe), and the loading of library.dll.
author: bay-ar4fah
date: 2026/06/02
tags:
    - attack.execution
    - attack.t1204
    - attack.t1218.011
logsource:
    category: process_creation
    product: windows
detection:
    selection_hashes:
        Hashes|contains:
            - 'SHA256=1c4a7589d26c97c38d4f826242b6740b35441e43ddd7394d399dbf94ab868483'
            - 'SHA256=55e7e424f6e98d7996fa457a46310d0172ce842b85dbfd294b0aa7afaa703a02'
            - 'SHA256=f020f75d6fac088b78abeaf848cba5b53ac0a2dd79be1ebe458f7a9514aa94b5'
            - 'SHA256=f867112deb0335e3a33464fe4e1737cc2176d5c118ce9fc7a5a0d45417035184'
    selection_files:
        Image|endswith:
            - '\mssecsvc.exe'
            - '\tasksche.exe'
    selection_dll_load:
        CommandLine|contains: 'library.dll'
    condition: selection_hashes or selection_files or selection_dll_load
falsepositives:
    - Sangat kecil kemungkinan false positive (High Fidelity).
level: critical
